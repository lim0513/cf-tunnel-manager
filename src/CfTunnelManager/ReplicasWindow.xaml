<Window x:Class="CfTunnelManager.ReplicasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="副本" Icon="Assets/app.ico" Width="860" MaxHeight="620" SizeToContent="Height" ResizeMode="NoResize"
        FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="{StaticResource Ink}"
        Background="White" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="HeaderCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Mist}" Padding="24,12">
            <Button Content="关闭" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" />
        </Border>
        <StackPanel Margin="24,20,24,18">
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="SameAddressText" Foreground="{StaticResource Alert}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"
                       Text="所有副本使用同一个公网 IP。线路故障时，它们可能同时掉线。" />
            <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Margin="0,14,0,0" ClipToBounds="True">
                <StackPanel>
                    <Border Background="{StaticResource Mist}" Padding="14,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="74" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="副本" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="1" Text="源站 IP" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="2" Text="边缘位置" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="3" Text="版本" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="4" Text="架构" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="5" Text="运行时间" Style="{StaticResource HeaderCell}" />
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="RowsList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="74" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Id}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding OriginIp}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Locations}" ToolTip="{Binding Locations}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding Version}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Architecture}" Foreground="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Uptime}" Foreground="{StaticResource Muted}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
