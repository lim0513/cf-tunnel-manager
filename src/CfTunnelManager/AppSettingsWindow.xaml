<Window x:Class="CfTunnelManager.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="应用设置" Icon="Assets/app.ico" Width="680" Height="680" ResizeMode="CanResizeWithGrip" MinWidth="580" MinHeight="460"
        FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="{StaticResource Ink}"
        Background="White" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SectionName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width" Value="70" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="DockPanel.Dock" Value="Right" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,5" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Mist}" Padding="24,12">
            <DockPanel>
                <Button Content="取消" IsCancel="True" />
                <Button x:Name="SaveButton" IsDefault="True" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="Save_Click" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="24,18,24,18"
                        TextBoxBase.TextChanged="Field_Changed"
                        ToggleButton.Checked="Field_Changed"
                        ToggleButton.Unchecked="Field_Changed"
                        Selector.SelectionChanged="Field_Changed">
                <TextBlock x:Name="IntroText" Foreground="{StaticResource Muted}" />

                <StackPanel x:Name="TunnelPanel" Visibility="Collapsed">
                    <TextBlock Text="隧道" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,6" />
                    <ComboBox x:Name="TunnelBox" ItemTemplate="{StaticResource TunnelOption}" />
                </StackPanel>

                <TextBlock Text="主机名" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,0" />
                <TextBlock Text="多级子域名需要高级证书管理器。" Style="{StaticResource FieldHint}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="子域名（可选）" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SubdomainBox" />
                        <TextBlock Text="例如 www、blog、api" Style="{StaticResource FieldHint}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="域" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ZoneBox" />
                        <TextBlock Text="账号下托管在 Cloudflare 的域名。" Style="{StaticResource FieldHint}" />
                    </StackPanel>
                </Grid>

                <Border Background="{StaticResource Mist}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="完整主机名：" Foreground="{StaticResource Muted}" FontSize="12" />
                        <TextBlock x:Name="FullHostnameText" FontFamily="Consolas" FontSize="14" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="路径（可选）" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PathBox" />
                        <TextBlock Text="可选正则表达式，例如 ^/api" Style="{StaticResource FieldHint}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Service URL" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ServiceBox" />
                        <TextBlock Text="例如 https://localhost:8080、tcp://localhost:3306" Style="{StaticResource FieldHint}" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="LocalPortPanel" Visibility="Collapsed">
                    <TextBlock Text="本地端口（可选）" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="LocalPortBox" Width="180" HorizontalAlignment="Left" />
                    <TextBlock Text="连接时映射到 127.0.0.1 的这个端口，留空则自动分配。只保存在本机。" Style="{StaticResource FieldHint}" />
                </StackPanel>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Alert}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

                <ToggleButton x:Name="AdvancedToggle" Margin="0,16,0,0" HorizontalAlignment="Left" Cursor="Hand" FocusVisualStyle="{StaticResource SignalFocus}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <TextBlock Text="其他应用程序设置" FontSize="14" FontWeight="SemiBold" />
                                <Path x:Name="Chevron" Data="M0,0 L5,5 L10,0" Stroke="{StaticResource Ink}" StrokeThickness="1.6"
                                      VerticalAlignment="Center" Margin="8,2,0,0" RenderTransformOrigin="0.5,0.5" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <StackPanel Visibility="{Binding IsChecked, ElementName=AdvancedToggle, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel Margin="0,6,0,12">
                        <Button Content="全部恢复默认" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Click="Reset_Click" Padding="0,0" />
                        <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="自定义 Cloudflare 连接到源站的方式。默认设置适用于大多数应用程序。" />
                    </DockPanel>

                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <StackPanel>
                            <Expander Style="{StaticResource SettingsSection}" BorderThickness="0,0,0,1">
                                <Expander.Header>
                                    <DockPanel>
                                        <Border x:Name="HttpPill" Style="{StaticResource Pill}"><TextBlock x:Name="HttpState" Style="{StaticResource PillLabel}" /></Border>
                                        <TextBlock Text="HTTP" Style="{StaticResource SectionName}" />
                                        <TextBlock Text="主机标头、编码" Style="{StaticResource SectionHint}" />
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="HTTP 主机标头" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="HttpHostHeaderBox" />
                                    <TextBlock Text="发送给源站的 Host 标头。" Style="{StaticResource FieldHint}" />
                                    <CheckBox x:Name="DisableChunkedBox" Content="禁用分块编码" Style="{StaticResource SwitchBox}" Margin="0,14,0,0" />
                                    <TextBlock Text="适用于 WSGI 等不支持分块编码的服务。" Style="{StaticResource FieldHint}" />
                                </StackPanel>
                            </Expander>

                            <Expander Style="{StaticResource SettingsSection}" BorderThickness="0,0,0,1">
                                <Expander.Header>
                                    <DockPanel>
                                        <Border x:Name="TlsPill" Style="{StaticResource Pill}"><TextBlock x:Name="TlsState" Style="{StaticResource PillLabel}" /></Border>
                                        <TextBlock Text="TLS" Style="{StaticResource SectionName}" />
                                        <TextBlock Text="Origin SSL、证书验证" Style="{StaticResource SectionHint}" />
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="源服务器名称" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="OriginServerNameBox" />
                                            <TextBlock Text="cloudflared 在源站证书中验证的主机名。" Style="{StaticResource FieldHint}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="TLS 超时" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="TlsTimeoutBox" />
                                            <TextBlock Text="等待 TLS 握手完成的秒数，默认 10。" Style="{StaticResource FieldHint}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="CA 池" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CaPoolBox" />
                                    <TextBlock Text="CA 证书在运行隧道的服务器上的路径，不是本机路径。" Style="{StaticResource FieldHint}" />
                                    <CheckBox x:Name="NoTlsVerifyBox" Content="无 TLS 验证" Style="{StaticResource SwitchBox}" Margin="0,14,0,0" />
                                    <TextBlock Text="适用于自签名证书。开启后无法确认源站身份。" Style="{StaticResource FieldHint}" />
                                    <CheckBox x:Name="Http2OriginBox" Content="HTTP/2 连接" Style="{StaticResource SwitchBox}" Margin="0,12,0,0" />
                                    <TextBlock Text="用 HTTP/2 连接源站，源站必须是 HTTPS 服务。" Style="{StaticResource FieldHint}" />
                                    <CheckBox x:Name="MatchSniBox" Content="SNI 匹配主机" Style="{StaticResource SwitchBox}" Margin="0,12,0,0" />
                                    <TextBlock Text="把 TLS SNI 设为请求的 Host 值。" Style="{StaticResource FieldHint}" />
                                </StackPanel>
                            </Expander>

                            <Expander Style="{StaticResource SettingsSection}" BorderThickness="0,0,0,1">
                                <Expander.Header>
                                    <DockPanel>
                                        <Border x:Name="ConnectionPill" Style="{StaticResource Pill}"><TextBlock x:Name="ConnectionState" Style="{StaticResource PillLabel}" /></Border>
                                        <TextBlock Text="连接" Style="{StaticResource SectionName}" />
                                        <TextBlock Text="超时、保持连接、代理模式" Style="{StaticResource SectionHint}" />
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="连接超时" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="ConnectTimeoutBox" />
                                            <TextBlock Text="等待建立 TCP 连接的秒数，默认 30。" Style="{StaticResource FieldHint}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Keep-Alive 超时" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="KeepAliveTimeoutBox" />
                                            <TextBlock Text="空闲连接保持开放的秒数，默认 90。" Style="{StaticResource FieldHint}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1">
                                            <TextBlock Text="Keep-Alive 连接" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="KeepAliveConnectionsBox" />
                                            <TextBlock Text="到源站的最大空闲连接数，默认 100。" Style="{StaticResource FieldHint}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBlock Text="TCP 保活间隔" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="TcpKeepAliveBox" />
                                            <TextBlock Text="空闲连接上发送探测的间隔秒数，默认 30。" Style="{StaticResource FieldHint}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2">
                                            <TextBlock Text="代理类型" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="ProxyTypeBox">
                                                <ComboBoxItem Content="默认" />
                                                <ComboBoxItem Content="SOCKS" />
                                            </ComboBox>
                                            <TextBlock Text="不遵循 HTTP 语义的协议可使用 SOCKS 代理。" Style="{StaticResource FieldHint}" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="NoHappyEyeballsBox" Content="禁用 Happy Eyeballs" Style="{StaticResource SwitchBox}" Margin="0,14,0,0"
                                              ToolTip="禁用 IPv4 和 IPv6 之间的自动回退。" />
                                </StackPanel>
                            </Expander>

                            <Expander Style="{StaticResource SettingsSection}" BorderThickness="0">
                                <Expander.Header>
                                    <DockPanel>
                                        <Border x:Name="AccessPill" Style="{StaticResource Pill}"><TextBlock x:Name="AccessState" Style="{StaticResource PillLabel}" /></Border>
                                        <TextBlock Text="Access" Style="{StaticResource SectionName}" />
                                        <TextBlock Text="在隧道处验证 Access JWT" Style="{StaticResource SectionHint}" />
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <CheckBox x:Name="AccessEnabledBox" Content="验证 Access JWT" Style="{StaticResource SwitchBox}" Margin="0,10,0,0" />
                                    <StackPanel IsEnabled="{Binding IsChecked, ElementName=AccessEnabledBox}">
                                        <CheckBox x:Name="AccessRequiredBox" Content="拒绝未通过 Access 授权的请求" Style="{StaticResource SwitchBox}" Margin="0,12,0,0" />
                                        <TextBlock Text="团队名称" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="AccessTeamNameBox" />
                                        <TextBlock Text="AUD 标签" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="AccessAudTagsBox" />
                                        <TextBlock Text="在 Access 应用的概览里可以找到。多个标签用逗号分隔。" Style="{StaticResource FieldHint}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
