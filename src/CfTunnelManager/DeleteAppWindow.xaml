<Window x:Class="CfTunnelManager.DeleteAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="删除应用" Icon="Assets/app.ico" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="{StaticResource Ink}"
        Background="White" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterOwner">
    <StackPanel>
        <StackPanel Margin="24,22,24,20">
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailText" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="ConnectionText" Text="这个应用的本地连接也会断开。" Foreground="{StaticResource Alert}" Margin="0,8,0,0" Visibility="Collapsed" />
            <CheckBox x:Name="DeleteDnsBox" Content="同时删除它的 DNS 记录" IsChecked="True" Margin="0,16,0,0" />
        </StackPanel>
        <Border Background="{StaticResource Mist}" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" IsDefault="True" />
                <Button Content="删除应用" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Delete_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
