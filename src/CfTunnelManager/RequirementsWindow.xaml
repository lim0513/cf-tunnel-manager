<Window x:Class="CfTunnelManager.RequirementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置要求" Icon="Assets/app.ico" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="{StaticResource Ink}"
        Background="White" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,3" />
        </Style>
        <Style x:Key="Detail" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
    </Window.Resources>
    <StackPanel>
        <StackPanel Margin="24,20,24,18">
            <TextBlock Text="使用前需要准备" FontSize="17" FontWeight="SemiBold" />

            <TextBlock Text="Cloudflare 账号" Style="{StaticResource Heading}" Margin="0,16,0,3" />
            <TextBlock Style="{StaticResource Detail}"
                       Text="需要是这个应用所属账号的成员。登录时会打开浏览器，请授权读取账号，以及管理 DNS 和隧道。" />

            <TextBlock Text="网页后台管理的隧道" Style="{StaticResource Heading}" />
            <TextBlock Style="{StaticResource Detail}"
                       Text="服务端的 cloudflared 要先装好并连上。用本地配置文件管理的隧道能看到状态，但无法查看或修改应用。" />

            <TextBlock Text="托管在 Cloudflare 的域名" Style="{StaticResource Heading}" />
            <TextBlock Style="{StaticResource Detail}"
                       Text="添加应用时会自动创建 DNS 记录，所以访问地址要属于这个账号下的域名。" />

            <TextBlock Text="本机的 cloudflared" Style="{StaticResource Heading}" />
            <TextBlock Style="{StaticResource Detail}"
                       Text="连接 TCP 应用时需要。只查看状态和打开 HTTP 应用时不需要。" />

            <TextBlock Text="空闲的 8976 端口" Style="{StaticResource Heading}" />
            <TextBlock Style="{StaticResource Detail}"
                       Text="浏览器授权完成后，通过本机的 8976 端口回到这个应用。" />
        </StackPanel>
        <Border Background="{StaticResource Mist}" Padding="24,12">
            <Button Content="知道了" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" />
        </Border>
    </StackPanel>
</Window>
