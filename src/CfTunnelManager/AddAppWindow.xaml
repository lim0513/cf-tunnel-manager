<Window x:Class="CfTunnelManager.AddAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加应用" Icon="Assets/app.ico" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="{StaticResource Ink}"
        Background="White" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterOwner">
    <StackPanel>
        <StackPanel Margin="24,20,24,16">
            <TextBlock Text="隧道" FontWeight="SemiBold" />
            <ComboBox x:Name="TunnelBox" ItemTemplate="{StaticResource TunnelOption}" Margin="0,6,0,14"
                      SelectionChanged="Preview_Changed" />
            <TextBlock Text="访问地址" FontWeight="SemiBold" />
            <TextBox x:Name="HostnameBox" Margin="0,6,0,14" TextChanged="Preview_Changed" />
            <TextBlock Text="后端服务" FontWeight="SemiBold" />
            <TextBox x:Name="ServiceBox" Margin="0,6,0,4" TextChanged="Preview_Changed" />
            <TextBlock Text="例如 http://localhost:8080 或 tcp://192.168.1.10:22" Foreground="{StaticResource Muted}" FontSize="12" />
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Alert}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
        </StackPanel>

        <Border Background="{StaticResource Mist}" Padding="24,14">
            <Grid x:Name="PreviewPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Rectangle Grid.RowSpan="2" Width="2" Height="34" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,10,0,0"
                           Stroke="{Binding StatusColor}" StrokeThickness="2" />
                <Ellipse Width="14" Height="14" Fill="{Binding StatusColor}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Ellipse Grid.Row="1" Width="10" Height="10" Fill="White" Stroke="{Binding StatusColor}" StrokeThickness="2"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,14,0,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                    <TextBlock x:Name="PreviewHostname" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PreviewService" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,14">
            <Button Content="取消" IsCancel="True" />
            <Button Content="添加应用" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Add_Click" />
        </StackPanel>
    </StackPanel>
</Window>
