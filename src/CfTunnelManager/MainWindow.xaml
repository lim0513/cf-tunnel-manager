<Window x:Class="CfTunnelManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tunnel Manager" Icon="Assets/app.ico" Width="980" Height="660" MinWidth="760" MinHeight="420"
        FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="{StaticResource Ink}"
        Background="{StaticResource Mist}" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <PathGeometry x:Key="TunnelPath" Figures="M30,104 L30,61 A34,34 0 0 1 98,61 L98,104" />
        <Storyboard x:Key="TunnelDotAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimationUsingPath Storyboard.TargetName="DotPosition" Storyboard.TargetProperty="X" Source="X"
                                      PathGeometry="{StaticResource TunnelPath}" Duration="0:0:1.2"
                                      AccelerationRatio="0.3" DecelerationRatio="0.3" />
            <DoubleAnimationUsingPath Storyboard.TargetName="DotPosition" Storyboard.TargetProperty="Y" Source="Y"
                                      PathGeometry="{StaticResource TunnelPath}" Duration="0:0:1.2"
                                      AccelerationRatio="0.3" DecelerationRatio="0.3" />
        </Storyboard>

        <DataTemplate x:Key="StationTemplate">
            <Border x:Name="Row" Background="Transparent" CornerRadius="3">
                <Grid MinHeight="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="27" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Rectangle x:Name="Rail" Width="2" HorizontalAlignment="Left" Margin="7,0,0,0"
                               Stroke="{Binding Tunnel.StatusColor}" StrokeThickness="2" />
                    <Ellipse Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,14,0,0"
                             Fill="White" Stroke="{Binding Tunnel.StatusColor}" StrokeThickness="2" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,9,12,8">
                        <TextBlock Text="{Binding Hostname}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Service}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding DnsText}" Foreground="{StaticResource Alert}" HorizontalAlignment="Right"
                                   Visibility="{Binding ShowDns, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource Navy}" HorizontalAlignment="Right" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Button Content="修复 DNS" Command="{Binding RepairDnsCommand}" Margin="0,0,6,0"
                                Visibility="{Binding CanRepairDns, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{Binding ActionText}" Command="{Binding ActionCommand}" MinWidth="64"
                                Visibility="{Binding ShowAction, Converter={StaticResource BoolToVisibility}}" />
                        <Button x:Name="DeleteButton" Content="删除" Command="{Binding DeleteCommand}" Style="{StaticResource QuietButton}"
                                Margin="4,0,0,0" Opacity="0" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tunnel.IsOnline}" Value="False">
                    <Setter TargetName="Rail" Property="StrokeDashArray" Value="2 2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLast}" Value="True">
                    <Setter TargetName="Rail" Property="VerticalAlignment" Value="Top" />
                    <Setter TargetName="Rail" Property="Height" Value="16" />
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="White" />
                    <Setter TargetName="DeleteButton" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="DeleteButton" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TunnelTemplate">
            <StackPanel>
            <Rectangle x:Name="Divider" Height="1" Fill="{StaticResource Line}" Margin="6,0,6,12" />
            <Expander IsExpanded="{Binding IsExpanded}" Style="{StaticResource TunnelGroup}" Margin="0,0,0,12">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="Lamp" Width="14" Height="14" Fill="{Binding StatusColor}" Stroke="{Binding StatusColor}" StrokeThickness="2"
                                 VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" Margin="12,1,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AppCountText}" Foreground="{StaticResource Muted}" Margin="12,1,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SeenText}" Foreground="{StaticResource Muted}" Margin="12,1,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource Muted}" Margin="12,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="6,-12,0,0">
                    <TextBlock Text="{Binding Notice}" Foreground="{StaticResource Alert}" Margin="27,16,0,4" TextWrapping="Wrap"
                               Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="这条隧道还没有发布应用。" Foreground="{StaticResource Muted}" Margin="27,16,0,4"
                               Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVisibility}}" />
                    <Rectangle x:Name="Connector" Width="2" Height="14" HorizontalAlignment="Left" Margin="7,0,0,0"
                               Stroke="{Binding StatusColor}" StrokeThickness="2"
                               Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource StationTemplate}" Focusable="False" />
                </StackPanel>
            </Expander>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                    <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                    <Setter TargetName="Lamp" Property="Fill" Value="Transparent" />
                    <Setter TargetName="Connector" Property="StrokeDashArray" Value="2 2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Ink}" Padding="20,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource HeaderButton}" Margin="0,0,8,0" />
                        <Button Content="退出登录" Command="{Binding SignOutCommand}" Style="{StaticResource HeaderButton}" Margin="0,0,8,0" />
                        <Button Content="添加应用" Click="AddApp_Click" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding AccountName}" Foreground="White" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CountsText}" Foreground="#A9BACC" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="14,16,14,0">
                <ItemsControl ItemsSource="{Binding Tunnels}" ItemTemplate="{StaticResource TunnelTemplate}" Focusable="False" />
            </ScrollViewer>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ShowNoTunnels, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="账号下还没有隧道" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="在 Cloudflare 后台创建隧道后，点“刷新”。" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <Grid x:Name="LoadingPanel" Background="{StaticResource Mist}"
              Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="128" Height="128" HorizontalAlignment="Center">
                    <Path Data="{StaticResource TunnelPath}" Stroke="{StaticResource Navy}" StrokeThickness="14"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Ellipse Width="20" Height="20" Fill="{StaticResource Signal}" Canvas.Left="-10" Canvas.Top="-10">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="DotPosition" X="64" Y="74" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
                <TextBlock Text="正在读取隧道" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Grid Background="{StaticResource Ink}" Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVisibility}}">
            <Viewbox VerticalAlignment="Bottom" Margin="0,28,0,0" Stretch="Uniform" StretchDirection="Both">
                <Grid Width="520" Height="520">
                    <Path Data="M50,560 L50,260 A210,210 0 0 1 470,260 L470,560" Stroke="{StaticResource Navy}" StrokeThickness="30" />
                    <Path Data="M100,560 L100,260 A160,160 0 0 1 420,260 L420,560" Stroke="#183857" StrokeThickness="2" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,190,0,0">
                        <Ellipse Width="22" Height="22" Fill="{StaticResource Signal}" HorizontalAlignment="Center" Margin="0,0,0,24" />
                        <TextBlock Text="Tunnel Manager" Foreground="White" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="查看隧道状态，管理已发布的应用" Foreground="#A9BACC" FontSize="14" Margin="0,8,0,28" HorizontalAlignment="Center" />
                        <Button Content="登录 Cloudflare" Command="{Binding SignInCommand}" Style="{StaticResource PrimaryButton}"
                                Padding="32,10" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                Visibility="{Binding HasClientId, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Visibility="{Binding NeedsClientId, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Foreground="White" FontSize="14" Width="300" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22"
                                       Text="登录前要先在 Cloudflare 创建 OAuth 客户端，并填入它的 Client ID。" />
                            <Button Content="查看配置步骤" Click="Requirements_Click" Style="{StaticResource PrimaryButton}"
                                    Padding="32,10" Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Viewbox>
            <Button Content="?" Click="Requirements_Click" ToolTip="配置要求" AutomationProperties.Name="配置要求"
                    Style="{StaticResource HelpButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" />
        </Grid>

        <Border VerticalAlignment="Bottom" Margin="16" Padding="14,10" CornerRadius="3" Background="{StaticResource Navy}"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Message}" Foreground="White" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
