<Window x:Class="CfTunnelManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tunnel Manager" Icon="Assets/app.ico" Width="980" Height="660" MinWidth="760" MinHeight="420"
        FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="{StaticResource Ink}"
        Background="{DynamicResource Canvas}" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <PathGeometry x:Key="TunnelPath" Figures="M30,104 L30,61 A34,34 0 0 1 98,61 L98,104" />
        <Storyboard x:Key="TunnelDotAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimationUsingPath Storyboard.TargetName="DotPosition" Storyboard.TargetProperty="X" Source="X"
                                      PathGeometry="{StaticResource TunnelPath}" Duration="0:0:1.2"
                                      AccelerationRatio="0.3" DecelerationRatio="0.3" />
            <DoubleAnimationUsingPath Storyboard.TargetName="DotPosition" Storyboard.TargetProperty="Y" Source="Y"
                                      PathGeometry="{StaticResource TunnelPath}" Duration="0:0:1.2"
                                      AccelerationRatio="0.3" DecelerationRatio="0.3" />
        </Storyboard>

        <DataTemplate x:Key="StationTemplate">
            <Border x:Name="Row" Background="Transparent" CornerRadius="3">
                <Grid MinHeight="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="27" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Rectangle x:Name="Rail" Width="2" HorizontalAlignment="Left" Margin="7,0,0,0"
                               Stroke="{Binding Tunnel.StatusColor}" StrokeThickness="2" />
                    <Ellipse Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,14,0,0"
                             Fill="White" Stroke="{Binding Tunnel.StatusColor}" StrokeThickness="2" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,9,12,8">
                        <TextBlock Text="{Binding Hostname}" Foreground="{DynamicResource RowText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Service}" Foreground="{DynamicResource RowMuted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding DnsText}" Foreground="{DynamicResource RowWarning}" HorizontalAlignment="Right"
                                   Visibility="{Binding ShowDns, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding ConnectionText}" Foreground="{DynamicResource RowConnection}" HorizontalAlignment="Right"
                                   Visibility="{Binding ShowConnection, Converter={StaticResource BoolToVisibility}}" />
                        <Border Background="{DynamicResource PillFill}" CornerRadius="11" Height="22" Padding="10,0" HorizontalAlignment="Right"
                                Visibility="{Binding HasCustomSettings, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="已自定义设置" Foreground="{DynamicResource PillText}" Style="{StaticResource PillLabel}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Button Content="修复 DNS" Command="{Binding RepairDnsCommand}" Margin="0,0,6,0"
                                Visibility="{Binding CanRepairDns, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{Binding ActionIcon}" Command="{Binding ActionCommand}" Style="{StaticResource IconButton}"
                                Foreground="{Binding ActionForeground}" BorderBrush="{Binding ActionColor}" Background="{Binding ActionColor}"
                                ToolTip="{Binding ActionText}" AutomationProperties.Name="{Binding ActionText}"
                                Visibility="{Binding ShowAction, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{StaticResource IconSettings}" Command="{Binding SettingsCommand}" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                Foreground="{StaticResource Ink}" Background="{StaticResource Sun}" BorderBrush="{StaticResource Sun}"
                                ToolTip="设置" AutomationProperties.Name="设置" />
                        <Button x:Name="DeleteButton" Content="{StaticResource IconDelete}" Command="{Binding DeleteCommand}" Style="{StaticResource IconButton}"
                                Foreground="White" Background="{StaticResource Danger}" BorderBrush="{StaticResource Danger}" Margin="6,0,0,0" Opacity="0" ToolTip="删除" AutomationProperties.Name="删除" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tunnel.IsOnline}" Value="False">
                    <Setter TargetName="Rail" Property="StrokeDashArray" Value="2 2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLast}" Value="True">
                    <Setter TargetName="Rail" Property="VerticalAlignment" Value="Top" />
                    <Setter TargetName="Rail" Property="Height" Value="16" />
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowHover}" />
                    <Setter TargetName="DeleteButton" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="DeleteButton" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TunnelTemplate">
            <Expander IsExpanded="{Binding IsExpanded}" Style="{StaticResource TunnelGroup}" Margin="0,0,0,14" Foreground="{StaticResource Ink}">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="168" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="Lamp" Width="14" Height="14" Fill="{StaticResource Ink}" Stroke="{StaticResource Ink}" StrokeThickness="2"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="17" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="2" Background="{StaticResource Ink}" CornerRadius="10" Height="20" Padding="10,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" FontSize="12" Style="{StaticResource PillLabel}" />
                        </Border>
                        <TextBlock Grid.Column="3" Text="{Binding AppCountText}" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding SeenText}" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                        <Button Grid.Column="5" Content="{Binding ReplicaText}" Command="{Binding ShowReplicasCommand}" Style="{StaticResource ReplicaLink}"
                                ToolTip="查看副本" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Visibility="{Binding HasReplicas, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Expander.Header>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource RowWarning}" Margin="27,10,0,4" TextWrapping="Wrap"
                               Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="这条隧道还没有发布应用。" Foreground="{DynamicResource RowMuted}" Margin="27,10,0,4"
                               Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVisibility}}" />
                    <Rectangle x:Name="Connector" Width="2" Height="4" HorizontalAlignment="Left" Margin="7,0,0,0"
                               Stroke="{Binding StatusColor}" StrokeThickness="2"
                               Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource StationTemplate}" Focusable="False" />
                </StackPanel>
            </Expander>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                    <Setter TargetName="Lamp" Property="Fill" Value="Transparent" />
                    <Setter TargetName="Connector" Property="StrokeDashArray" Value="2 2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource Bar}" Padding="20,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ThemeButton" Click="Theme_Click" Style="{StaticResource IconButton}" Margin="0,0,8,0"
                                Foreground="{DynamicResource BarText}" Background="Transparent" BorderBrush="{DynamicResource BarOutline}" />
                        <Button Content="{StaticResource IconRefresh}" Command="{Binding RefreshCommand}" Style="{StaticResource IconButton}" Margin="0,0,8,0"
                                Foreground="{DynamicResource BarText}" Background="Transparent" BorderBrush="{DynamicResource BarOutline}"
                                ToolTip="刷新" AutomationProperties.Name="刷新" />
                        <Button Content="{StaticResource IconSignOut}" Command="{Binding SignOutCommand}" Style="{StaticResource IconButton}" Margin="0,0,8,0"
                                Foreground="{DynamicResource BarText}" Background="Transparent" BorderBrush="{DynamicResource BarOutline}"
                                ToolTip="退出登录" AutomationProperties.Name="退出登录" />
                        <Button Content="{StaticResource IconAdd}" Click="AddApp_Click" Style="{StaticResource IconButton}"
                                Foreground="{StaticResource Ink}" Background="{StaticResource Signal}" BorderBrush="{StaticResource Signal}"
                                ToolTip="添加应用" AutomationProperties.Name="添加应用" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding AccountName}" Foreground="{DynamicResource BarText}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CountsText}" Foreground="{DynamicResource BarMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="14,16,14,0">
                <ItemsControl ItemsSource="{Binding Tunnels}" ItemTemplate="{StaticResource TunnelTemplate}" Focusable="False" />
            </ScrollViewer>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ShowNoTunnels, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="账号下还没有隧道" Foreground="{DynamicResource RowText}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="在 Cloudflare 后台创建隧道后，点“刷新”。" Foreground="{DynamicResource RowMuted}" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <Grid x:Name="LoadingPanel" Background="{DynamicResource Canvas}"
              Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="128" Height="128" HorizontalAlignment="Center">
                    <Path Data="{StaticResource TunnelPath}" Stroke="{DynamicResource RowText}" StrokeThickness="14"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Ellipse Width="20" Height="20" Fill="{StaticResource Signal}" Canvas.Left="-10" Canvas.Top="-10">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="DotPosition" X="64" Y="74" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
                <TextBlock Text="正在读取隧道" Foreground="{DynamicResource RowMuted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Grid Background="{StaticResource Ink}" Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVisibility}}">
            <Viewbox VerticalAlignment="Bottom" Margin="0,28,0,0" Stretch="Uniform" StretchDirection="Both">
                <Grid Width="520" Height="520">
                    <Path Data="M50,560 L50,260 A210,210 0 0 1 470,260 L470,560" Stroke="{StaticResource Navy}" StrokeThickness="30" />
                    <Path Data="M100,560 L100,260 A160,160 0 0 1 420,260 L420,560" Stroke="#183857" StrokeThickness="2" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,190,0,0">
                        <Ellipse Width="22" Height="22" Fill="{StaticResource Signal}" HorizontalAlignment="Center" Margin="0,0,0,24" />
                        <TextBlock Text="Tunnel Manager" Foreground="White" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="查看隧道状态，管理已发布的应用" Foreground="#A9BACC" FontSize="14" Margin="0,8,0,28" HorizontalAlignment="Center" />
                        <Button Content="登录 Cloudflare" Command="{Binding SignInCommand}" Style="{StaticResource PrimaryButton}"
                                Padding="32,10" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                Visibility="{Binding HasClientId, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Visibility="{Binding NeedsClientId, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Foreground="White" FontSize="14" Width="300" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22"
                                       Text="登录前要先在 Cloudflare 创建 OAuth 客户端，并填入它的 Client ID。" />
                            <Button Content="查看配置步骤" Click="Requirements_Click" Style="{StaticResource PrimaryButton}"
                                    Padding="32,10" Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Viewbox>
            <Button Content="?" Click="Requirements_Click" ToolTip="配置要求" AutomationProperties.Name="配置要求"
                    Style="{StaticResource HelpButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" />
        </Grid>

        <Border VerticalAlignment="Bottom" Margin="16" Padding="14,10" CornerRadius="3" Background="{StaticResource Navy}"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Message}" Foreground="White" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
